# Optional template.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements/control.lock requirements/transformers.lock /app/requirements/
RUN python3 -m venv /app/.runtime/transformers \
    && /app/.runtime/transformers/bin/pip install --no-cache-dir -r requirements/control.lock -r requirements/transformers.lock
COPY . /app
ENV PATH=/app/.runtime/transformers/bin:$PATH
EXPOSE 8000
# Mount/download weights separately. Review authentication and network exposure.
ENTRYPOINT ["./model-server"]
CMD ["start", "--config", "configs/gams3-v100-int8.yaml", "--no-detach", "--skip-doctor"]
